{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Vite 개발 서버 시작",
            "type": "process",
            "command": "npm",
            "args": [
                "run",
                "dev",
                "--",
                "--host",
                "localhost",
                "--port",
                "8443"
            ],
            "isBackground": true,
            "problemMatcher": {
                "owner": "vite",
                "pattern": {
                    "regexp": "^\\s*$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^\\s*VITE v",
                    "endsPattern": "^\\s*➜\\s+Local:\\s+http://localhost:8443/?$"
                }
            }
        }
    ]
}
